# Session cookie encryption. Minimum 32 characters.
NUXT_SESSION_PASSWORD=replace-with-a-long-random-string-of-32-chars

# GitHub OAuth application (https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# PostgreSQL connection string
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixed_by_design

# Comma-separated GitHub logins promoted to admin on first sign-in
NUXT_ADMIN_GITHUB_LOGINS=

# Public site URL, used for canonical URLs, sitemap and Open Graph
NUXT_PUBLIC_SITE_URL=http://localhost:3000
